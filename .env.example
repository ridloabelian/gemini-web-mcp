# ============================================================================
# Konfigurasi Gemini Web Playwright MCP Server
# Salin ke `.env`: cp .env.example .env
# ============================================================================

# Lokasi persistent browser profile (menyimpan login Google / cookies / IndexedDB)
GEMINI_PROFILE_DIR=~/.gemini-web-mcp/profile

# Mode headless untuk eksekusi lokal ("true" atau "false").
# Catatan: Di dalam Docker + Xvfb, disarankan "false" karena layar virtual :99 aktif.
GEMINI_HEADLESS=true

# Channel browser: "chrome" (disarankan di laptop/PC), "msedge", atau kosongkan "" untuk Chromium bawaan
GEMINI_BROWSER_CHANNEL=chrome

# Opsional: Attach ke instance Chrome yang sudah jalan dengan --remote-debugging-port=9222
GEMINI_CDP_URL=

# URL dasar Gemini Web App
GEMINI_BASE_URL=https://gemini.google.com/app

# Batas waktu tunggu maksimal respons streaming Gemini (detik)
GEMINI_RESPONSE_TIMEOUT=180

# Opsional namun SANGAT DISARANKAN untuk mode HTTP/SSE di VPS/Homelab:
# Jika diisi, klien wajib mengirim header `Authorization: Bearer <token>`
GEMINI_AUTH_TOKEN=

# Pengaturan khusus Docker (Xvfb + noVNC untuk login akun Google pertama kali via browser)
ENABLE_NOVNC=true
NOVNC_PORT=6080
MCP_PORT=8765
