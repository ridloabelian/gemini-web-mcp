# ============================================================================
# Gemini Web Playwright MCP Server Configuration
# Copy to `.env`: cp .env.example .env
# ============================================================================

# Persistent browser profile directory (stores Google session / cookies / IndexedDB)
GEMINI_PROFILE_DIR=~/.gemini-web-mcp/profile

# Headless mode for local runs ("true" or "false").
# Note: Inside Docker + Xvfb, keep "false" so Chromium runs headed on virtual display :99.
GEMINI_HEADLESS=true

# Browser channel: "chrome" (recommended on desktop), "msedge", or "" for bundled Chromium
GEMINI_BROWSER_CHANNEL=chrome

# Optional: Attach to an existing Chrome instance started with --remote-debugging-port=9222
GEMINI_CDP_URL=

# Base URL for the Gemini web app
GEMINI_BASE_URL=https://gemini.google.com/app

# Maximum streaming response timeout in seconds
GEMINI_RESPONSE_TIMEOUT=180

# Optional (STRONGLY RECOMMENDED for remote HTTP/SSE deployments):
# Requires clients to send `Authorization: Bearer <token>`
GEMINI_AUTH_TOKEN=

# Docker-only settings (Xvfb + noVNC portal for initial Google account login)
ENABLE_NOVNC=true
NOVNC_PORT=6080
MCP_PORT=8765
